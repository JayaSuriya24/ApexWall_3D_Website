# Phone verification (OTP) and leads. Copy to .env.local (never commit real values).
# Without these, development mode prints codes in the terminal and keeps data in memory.
# In production (npm run build && npm start), every value below is required.

# Random 32+ character strings, e.g. `openssl rand -base64 32`
SESSION_SECRET=
OTP_HASH_SECRET=

# MSG91 (https://msg91.com): auth key + a DLT-approved OTP template containing ##OTP##
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Supabase (https://supabase.com): Project Settings → API. Service role key = server only.
# Create the tables with supabase/migrations/20261016000000_phone_verification.sql
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile): bot check before sending codes
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
